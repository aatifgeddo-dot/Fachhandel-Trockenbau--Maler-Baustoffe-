
<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Renass Trockenbau | Online Shop</title>
<!-- ربط مكتبة Tailwind CSS للتصميم السريع والعصري -->
<script src="https://jsdelivr.net"></script>
<style>
/* تخصيص ألوان الهوية الخاصة بك */
.brand-red { color: #E52321; }
.brand-blue { color: #1E40AF; }
.bg-brand-blue { background-color: #0F172A; }
</style>
</head>
<body class="bg-gray-50 text-gray-800 font-sans">

<!-- شريط التنقل العلوي (Navbar) -->
<nav class="bg-white shadow-md sticky top-0 z-50">
<div class="container mx-auto px-6 py-4 flex justify-between items-center">
<div class="flex items-center space-x-2">
<!-- هنا تضع لوقو المتجر المستقبلي -->
<span class="text-2xl font-black tracking-wider"><span class="brand-red">RENASS</span> <span class="brand-blue">TROCKENBAU</span></span>
</div>
<div class="hidden md:flex space-x-8 font-medium">
<a href="#" class="hover:text-red-600 transition">Startseite</a>
<a href="#" class="hover:text-red-600 transition">Produkte</a>
<a href="#" class="hover:text-red-600 transition">Rechner</a>
<a href="#" class="hover:text-red-600 transition">Kontakt</a>
</div>
<div class="relative">
<button class="bg-blue-600 text-white px-4 py-2 rounded-lg font-semibold hover:bg-blue-700 transition flex items-center">
🛒 Warenkorb (<span id="cart-count">0</span>)
</button>
</div>
</div>
</nav>

<!-- واجهة الموقع الترحيبية (Hero Section) -->
<header class="bg-brand-blue text-white py-20 px-6 text-center bg-cover bg-center" style="background-image: linear-gradient(rgba(15, 23, 42, 0.8), rgba(15, 23, 42, 0.9));">
<h1 class="text-4xl md:text-6xl font-extrabold mb-4 tracking-tight">Meisterbetrieb für Decken • Wände • Maler</h1>
<p class="text-lg md:text-xl text-gray-300 max-w-2xl mx-auto mb-8">Ihr zuverlässiger Partner für Trockenbau-Materialien in Deutschland. Qualität, die hält.</p>
<a href="#shop" class="bg-red-600 text-white px-8 py-3 rounded-full text-lg font-bold hover:bg-red-700 transition shadow-lg">Jetzt Einkaufen</a>
</header>

<!-- قسم المنتجات الرئيسي (Product Grid) -->
<main id="shop" class="container mx-auto px-6 py-16">
<h2 class="text-3xl font-bold mb-10 border-b pb-4 text-gray-900">Unsere Produkte (منتجاتنا)</h2>

<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
<!-- المنتج الأول -->
<div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-xl transition border border-gray-100 flex flex-col justify-between">
<div class="p-6">
<span class="text-xs font-bold uppercase tracking-wider text-blue-600">Platten</span>
<h3 class="text-xl font-bold mt-1 mb-2 text-gray-900">Gipskartonplatte Standard 12.5mm</h3>
<p class="text-gray-600 text-sm">Geeignet für Wand- und Deckenbekleidungen auf Metall- oder Holzunterkonstruktionen.</p>
</div>
<div class="p-6 bg-gray-50 flex justify-between items-center border-t border-gray-100">
<span class="text-2xl font-black text-gray-900">€9.50 <span class="text-xs text-gray-500 font-normal">/Stk</span></span>
<button onclick="addToCart()" class="bg-blue-600 text-white px-4 py-2 rounded-md text-sm font-bold hover:bg-blue-700 transition">In den Warenkorb</button>
</div>
</div>

<!-- المنتج الثاني -->
<div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-xl transition border border-gray-100 flex flex-col justify-between">
<div class="p-6">
<span class="text-xs font-bold uppercase tracking-wider text-green-600">Feuchtraum</span>
<h3 class="text-xl font-bold mt-1 mb-2 text-gray-900">Gipskartonplatte Imprägniert (Grün)</h3>
<p class="text-gray-600 text-sm">Ideal für Badezimmer und feuchte Räume geeignet. Kern und Karton gegen Feuchtigkeit geschützt.</p>
</div>
<div class="p-6 bg-gray-50 flex justify-between items-center border-t border-gray-100">
<span class="text-2xl font-black text-gray-900">€14.20 <span class="text-xs text-gray-500 font-normal">/Stk</span></span>
<button onclick="addToCart()" class="bg-blue-600 text-white px-4 py-2 rounded-md text-sm font-bold hover:bg-blue-700 transition">In den Warenkorb</button>
</div>
</div>

<!-- المنتج الثالث (البراغي بالكرتون) -->
<div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-xl transition border border-gray-100 flex flex-col justify-between">
<div class="p-6">
<span class="text-xs font-bold uppercase tracking-wider text-red-600">Zubehör</span>
<h3 class="text-xl font-bold mt-1 mb-2 text-gray-900">Schnellbauschrauben (Gurt/Karton)</h3>
<p class="text-gray-600 text-sm">Feingewinde für Metallprofile. 3.5 x 25 mm. Packungsinhalt: 500 Stück.</p>
</div>
<div class="p-6 bg-gray-50 flex justify-between items-center border-t border-gray-100">
<span class="text-2xl font-black text-gray-900">€18.90 <span class="text-xs text-gray-500 font-normal">/Karton</span></span>
<button onclick="addToCart()" class="bg-blue-600 text-white px-4 py-2 rounded-md text-sm font-bold hover:bg-blue-700 transition">In den Warenkorb</button>
</div>
</div>
</div>
</main>

<!-- تذييل الصفحة (Footer) -->
<footer class="bg-gray-900 text-gray-400 py-8 text-center border-t border-gray-800">
<p>&copy; 2026 RENASS TROCKENBAU. Alle Rechte vorbehalten. Designed for GitHub Pages.</p>
</footer>

<!-- كود الجافاسكريبت التفاعلي للسلة -->
<script>
let count = 0;
function addToCart() {
count++;
document.getElementById('cart-count').innerText = count;
alert('Produkt wurde zum Warenkorb hinzugefügt! (تمت إضافة المنتج للسلة)');
}
</script>
</body>
</html>

